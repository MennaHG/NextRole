# Optional local configuration. Never commit a real .env file.
NEXTROLE_PROFILE_PATH=examples/profile.example.md
NEXTROLE_LLM_PROVIDER=
NEXTROLE_LLM_MODEL=
NEXTROLE_EMBEDDING_PROVIDER=
NEXTROLE_EMBEDDING_MODEL=
NEXTROLE_LOG_LEVEL=INFO
NEXTROLE_PROFILE_PATH=private/profile.md
# Perplexity Search API. Leave empty for offline fixture and dry-run modes.
PERPLEXITY_API_KEY=
MAX_SEARCH_REQUESTS_PER_RUN=1
MAX_SEARCH_RETRIES=0
SEARCH_MAX_RESULTS=20
SEARCH_MAX_AGE_HOURS=24
SEARCH_COUNTRY=
# JSON list, for example: ["backend engineer Egypt", "Python developer remote"]
SEARCH_QUERIES=[]
